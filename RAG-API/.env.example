# IMPORTANTE: Copiar este archivo a .env y configurar con valores reales
# NUNCA subir .env a control de versiones

# DeepSeek API Configuration
DEEPSEEK_API_KEY=sk-CHANGE-ME-WITH-YOUR-REAL-KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Ollama Configuration (local embeddings)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_MODEL=nomic-embed-text:latest

# ChromaDB Vector Store
CHROMA_PATH=./data/chroma

# Text Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
BATCH_SIZE=50

# JWT Security - GENERAR CON: openssl rand -hex 32
JWT_SECRET=CHANGE-ME-GENERATE-WITH-OPENSSL

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Environment
ENVIRONMENT=development
DEBUG=false