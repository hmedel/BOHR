        }
        
        .auth-form h2 {
            color: var(--unam-azul);
            margin-bottom: 10px;
            font-size: 2em;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: var(--unam-azul);
        }
        
        .form-group input {
