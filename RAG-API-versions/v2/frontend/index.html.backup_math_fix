<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asistente de Estructura de la Materia - FESC-UNAM</title>
    
    <!-- Marked.js para Markdown -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    
    <!-- Highlight.js para código -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    
    <!-- KaTeX para matemáticas -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            --unam-azul: #003D7A;
            --unam-oro: #FFB800;
            --unam-azul-oscuro: #002855;
            --unam-gris: #F5F5F5;
            --texto-oscuro: #1a1a1a;
            --texto-claro: #ffffff;
            --borde: #e0e0e0;
            --success: #4caf50;
            --error: #f44336;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            background: var(--unam-gris);
            color: var(--texto-oscuro);
            height: 100vh;
            overflow: hidden;
        }
        
        /* [Todos los estilos CSS anteriores - sin cambios] */
        /* Copio los estilos que ya teníamos... */
        
        .auth-container {
            display: flex;
            min-height: 100vh;
            background: linear-gradient(135deg, var(--unam-azul) 0%, var(--unam-azul-oscuro) 100%);
        }
        
        .auth-left {
            flex: 1;
